# LoopBook - Configuración de Variables de Entorno de Ejemplo
# Instrucciones: Renombra este archivo como '.env' en la raíz del proyecto y ajusta los valores locales.
# IMPORTANTE: Nunca incluyas el archivo '.env' real en el control de versiones.

# Configuración de la Base de Datos (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loopbook
DB_USER=root
DB_PASS=your_password_here
